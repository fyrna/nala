fn main() -> void {
    let a: u32 = 5;
    let b: u32 = 10;
    
    // if
    if a < b {
        print_u8!(1);
    } else {
        print_u8!(0);
    }
    
    // if-else chain
    if a == 0 {
        print_u8!(10);
    } else if a == 5 {
        print_u8!(20);
    } else {
        print_u8!(30);
    }
    
    // if expression
    let max: u32 = if a > b { a } else { b };
    print_u32!(max);
}
