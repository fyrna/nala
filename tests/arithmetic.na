fn main() -> void {
    let a: u32 = 10;
    let b: u32 = 5;
    let c: u32 = 3;
    let z: u32 = 0;

    // add
    print_u32!(a + b); // 15
    print_u32!(a + 0); // 10
    print_u32!(0 + b); // 5

    // sub
    print_u32!(a - b); // 5
    print_u32!(a - a); // 0

    // mul
    print_u32!(a * b); // 50
    print_u32!(a * 0); // 0
    print_u32!(0 * b); // 0
    print_u32!(a * 1); // 10

    // div
    print_u32!(a / b); // 2
    print_u32!(a / c); // 3
    print_u32!(a / 1); // 10

    // mod
    print_u32!(a % a); // 0
    print_u32!(a % b); // 0
    print_u32!(a % c); // 1
    print_u32!(b % a); // 5

    // precedence
    print_u32!(a + b * c);     // 25
    print_u32!((a + b) * c);   // 45
    print_u32!(a - b * c);     // 4294967291 (underflow jika u32 tanpa runtime check)
    print_u32!((a - b) * c);   // 15

    // variables
    let x: u32 = a + b;
    print_u32!(x); // 15

    let y: u32 = a * c;
    print_u32!(y); // 30

    // zero
    print_u32!(z); // 0
}
