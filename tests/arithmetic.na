// belum semua operator didukung

fn main() -> void {
    let a: u32 = 10;
    let b: u32 = 3;

    // plus
    let sum: u32 = a + b;
    print_u32!(sum);

    // cmp
    if a > b {
        print_u8!(1);
    }

    if a == 10 {
        print_u8!(2);
    }

    if a >= b {
        print_u8!(3);
    }

    if b <= a {
        print_u8!(4);
    }
}
