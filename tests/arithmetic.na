fn main() -> void {
    let lhs: u32 = 20;
    let rhs: u32 = 4;
    let factor: u32 = 3;
    let zero: u32 = 0;
    let one: u32 = 1;

    // add
    assert_eq!(lhs + rhs, 24);
    assert_eq!(lhs + zero, 20);
    assert_eq!(zero + rhs, 4);

    // sub
    assert_eq!(lhs - rhs, 16);
    assert_eq!(lhs - lhs, 0);

    // mul
    assert_eq!(lhs * rhs, 80);
    assert_eq!(lhs * zero, 0);
    assert_eq!(zero * rhs, 0);
    assert_eq!(lhs * one, 20);

    // div
    assert_eq!(lhs / rhs, 5);
    assert_eq!(lhs / factor, 6);
    assert_eq!(lhs / one, 20);

    // mod
    assert_eq!(lhs % lhs, 0);
    assert_eq!(lhs % rhs, 0);
    assert_eq!(lhs % factor, 2);
    assert_eq!(rhs % lhs, 4);

    // precedence
    assert_eq!(lhs + rhs * factor, 32);
    assert_eq!((lhs + rhs) * factor, 72);
    assert_eq!(lhs - rhs * factor, 8);
    assert_eq!((lhs - rhs) * factor, 48);

    // expression assignment
    let sum: u32 = lhs + rhs;
    assert_eq!(sum, 24);

    let product: u32 = lhs * factor;
    assert_eq!(product, 60);

    assert_eq!(zero, 0);
}
