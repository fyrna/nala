fn main() -> void {
    let t: bool = true;
    let f: bool = false;

    // AND
    if t and t {
        print_string!("PASS: t and t");
    } else {
        print_string!("FAIL: t and t");
    }

    if t and f {
        print_string!("FAIL: t and f");
    } else {
        print_string!("PASS: t and f");
    }

    if f and t {
        print_string!("FAIL: f and t");
    } else {
        print_string!("PASS: f and t");
    }

    if f and f {
        print_string!("FAIL: f and f");
    } else {
        print_string!("PASS: f and f");
    }

    // OR
    if t or t {
        print_string!("PASS: t or t");
    } else {
        print_string!("FAIL: t or t");
    }

    if t or f {
        print_string!("PASS: t or f");
    } else {
        print_string!("FAIL: t or f");
    }

    if f or t {
        print_string!("PASS: f or t");
    } else {
        print_string!("FAIL: f or t");
    }

    if f or f {
        print_string!("FAIL: f or f");
    } else {
        print_string!("PASS: f or f");
    }

    // NOT
    if !t {
        print_string!("FAIL: !t");
    } else {
        print_string!("PASS: !t");
    }

    if !f {
        print_string!("PASS: !f");
    } else {
        print_string!("FAIL: !f");
    }

    // Mixed
    if t and !f {
        print_string!("PASS: t and !f");
    } else {
        print_string!("FAIL: t and !f");
    }

    if !t or f {
        print_string!("FAIL: !t or f");
    } else {
        print_string!("PASS: !t or f");
    }
}
