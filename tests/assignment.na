fn main() -> void {
    let mut x: u32 = 10;
    let y: u32 = 7;

    // Simple assignment
    x = 20;
    if x == 20 {
        print_string!("PASS: x = 20");
    } else {
        print_string!("FAIL: x = 20");
    }

    // Assignment from variable
    x = y;
    if x == 7 {
        print_string!("PASS: x = y");
    } else {
        print_string!("FAIL: x = y");
    }

    // Assignment from expression
    x = y + 3;
    if x == 10 {
        print_string!("PASS: x = y + 3");
    } else {
        print_string!("FAIL: x = y + 3");
    }

    // Compound assignment
    x += 5;
    if x == 15 {
        print_string!("PASS: x += 5");
    } else {
        print_string!("FAIL: x += 5");
    }
}
