// array literal [N]T{...} -- satu-satunya syntax valid, N & T wajib eksplisit

fn main() -> void {
    let a: [1]i32 = [1]i32{42};
    print_i32!(a[0]); // 42

    let b: [4]u8 = [4]u8{1, 2, 3, 4};
    print_u8!(b[0]); // 1
    print_u8!(b[3]); // 4

    let mut c: [2]i32 = [2]i32{10, 20};
    print_i32!(c[0]); // 10
    print_i32!(c[1]); // 20

    // float array
    let d: [3]f32 = [3]f32{1.0, 2.0, 3.0};
    print_f32!(d[0]); // 1.0
    print_f32!(d[2]); // 3.0
}
