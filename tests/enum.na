const TokenKind = enum {
    EOF,
    Ident,
    IntLiteral,
    StringLiteral,
}

fn main() -> void {
    let mut kind: TokenKind = TokenKind.EOF;

    // --- Initial value ---

    if kind == TokenKind.EOF {
        print_string!("PASS: initial == EOF");
    } else {
        print_string!("FAIL: initial should be EOF");
    }

    // --- Reassign -> Ident ---

    kind = TokenKind.Ident;

    if kind == TokenKind.Ident {
        print_string!("PASS: reassigned == Ident");
    } else {
        print_string!("FAIL: reassigned should be Ident");
    }

    // if kind != TokenKind.EOF {
    //     print_string!("PASS: Ident != EOF");
    // } else {
    //     print_string!("FAIL: Ident should != EOF");
    // }

    // --- Reassign -> IntLiteral ---

    kind = TokenKind.IntLiteral;

    if kind == TokenKind.IntLiteral {
        print_string!("PASS: reassigned == IntLiteral");
    } else {
        print_string!("FAIL: reassigned should be IntLiteral");
    }

    // --- Reassign -> StringLiteral ---

    kind = TokenKind.StringLiteral;

    if kind == TokenKind.StringLiteral {
        print_string!("PASS: reassigned == StringLiteral");
    } else {
        print_string!("FAIL: reassigned should be StringLiteral");
    }

    // --- Negative comparisons ---

    if kind == TokenKind.EOF {
        print_string!("FAIL: StringLiteral == EOF");
    } else {
        print_string!("PASS: StringLiteral != EOF");
    }

    if kind == TokenKind.Ident {
        print_string!("FAIL: StringLiteral == Ident");
    } else {
        print_string!("PASS: StringLiteral != Ident");
    }

    if kind == TokenKind.IntLiteral {
        print_string!("FAIL: StringLiteral == IntLiteral");
    } else {
        print_string!("PASS: StringLiteral != IntLiteral");
    }

    let a: TokenKind = TokenKind.EOF;
    let b: TokenKind = TokenKind.EOF;
    let c: TokenKind = TokenKind.Ident;

    if a == b {
        print_string!("PASS: a == b");
    } else {
        print_string!("FAIL: a == b");
    }

    if a == c {
        print_string!("FAIL: a == c");
    } else {
        print_string!("PASS: a != c");
    }
}
