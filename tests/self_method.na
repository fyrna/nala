// useless test tbh

const Counter = struct {
    mut value: u32,
    
    fn get(&self) -> u32 {
        ret self.value;
    }
    
    fn increment(&mut self) -> void {
        self.value = self.value + 1;
    }
}

fn main() -> void {
    let mut c: Counter = Counter { value: 0 };
    
    print_u32!(c.get());
    
    c.increment();
    print_u32!(c.get());
    
    c.increment();
    c.increment();
    print_u32!(c.get());
}
