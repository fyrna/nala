const Option = union {
    Some(u8),
    None,
}

const Result = union {
    Ok(u32),
    Err([]u8),
}

fn main() -> void {
    // union construction with payload
    let opt1: Option = Option.Some(42);
    
    // union construction unit variant
    let opt2: Option = Option.None;
    
    // pattern match
    match opt1 {
        Option.Some(val) => {
            print_u8!(val);
        },
        Option.None => {
            print_u8!(0);
        },
    }

    // guard
    let res1: Result = Result.Ok(15);
    match res1 {
        Result.Ok(x) if x < 15 => {
            print_string!("smoll");
        }
        Result.Ok(x) if x == 15 => {
            print_string!("15 inch.");
        }
        Result.Ok(x) if x > 15 => {
            print_string!("MORE than 15 inch.");
        }
        Result.Err(err) => {
            print_string!(err);
        }
    }

    // err
    let res2: Result = Result.Err("im cute error");
    match res2 {
        Result.Ok(x) => {
            print_string!("im okay");
        }
        Result.Err(err) => {
            print_string!(err);
        }
    }
}
