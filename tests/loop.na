fn main() -> void {
    let i: u32 = 0;

    // basic while
    for i < 5 {
        print_u32!(i);
        i = i + 1;
    }

    // while with break
    let j: u32 = 0;
    for j < 100 {
        if j == 3 {
            break;
        }
        print_u32!(j);
        j = j + 1;
    }

    // while with continue
    let k: u32 = 0;
    for k < 5 {
        k = k + 1;
        if k == 3 {
            print_string!("surprise");
            continue;
        }
        print_u32!(k);
    }

    let arr: [3]i8 = [3]i8{1, 2, 3};
    print_usize!(len!(arr));  // 3

    // for-in
    for x in arr {
        if x == 3 {
            print_string!("sounds good");
        }
        print_i32!(x);  // 1, 2, 3
    }
}
